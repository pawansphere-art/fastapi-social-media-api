# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=your_postgres_user
# Leave empty if your local Postgres needs no password (Homebrew default on macOS)
DATABASE_PASSWORD=
DATABASE_NAME=fastapi

# Generate a key with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
